{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["libravoice", "handlandmarks"],
  "ios": {
    "iosModuleName": "LibraVoiceHandLandmarks"
  },
  "android": {
    "androidNamespace": ["libravoice", "handlandmarks"],
    "androidCxxLibName": "LibraVoiceHandLandmarks"
  },
  "autolinking": {
    "HandLandmarks": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridHandLandmarks"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridHandLandmarks"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
