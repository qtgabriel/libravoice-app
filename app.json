{
  "expo": {
    "name": "LibraVoice",
    "slug": "libravoice-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "libravoiceapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "O app usa a câmera para ler sinais de Libras.",
        "NSLocalNetworkUsageDescription": "O app usa a rede local para se conectar ao servidor de tradução.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "bundleIdentifier": "com.gabrielteodoro.libravoiceapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.anonymous.libravoiceapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-libravoice.png",
          "imageWidth": 300,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withUfscVideoTrust"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
