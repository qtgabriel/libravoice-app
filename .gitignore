.expo/
dist/
web-build/
expo-env.d.ts

# Native / build
.kotlin/
*.orig.*

# Signing / secrets
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision

# Metro
.metro-health-check*

